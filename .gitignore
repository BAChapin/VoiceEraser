# Editors
.vscode/
.idea/
*.swp
*~

# Generated build inputs (see Scripts/). Never committed: FFmpeg binaries are
# built by Scripts/build-ffmpeg.sh and the Core ML model by
# Scripts/convert-model.py, locally or in CI.
Vendor/
VoiceEraser/Resources/Models/*.mlpackage
.venv/
__pycache__/
*.pyc
